<Window x:Class="PCL.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCL Modular Shell" Height="720" Width="1080"
        FontFamily="Microsoft YaHei UI, 微软雅黑" FontSize="13"
        Background="{DynamicResource ColorBrushGray8}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：由主题模块算出的渐变在代码里写入 -->
        <Border x:Name="PanTitle" Grid.Row="0" Height="86" Background="{DynamicResource ColorBrush3}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PCL Modular" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="LabSubtitle" Foreground="#D8FFFFFF" Margin="0,4,0,0"
                               Text="模块化骨架 · 加载器 + 契约 + 独立模块" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="主题" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="ComboTheme" Width="150" Height="30" VerticalContentAlignment="Center"
                              SelectionChanged="ComboTheme_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 模块表 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="模块清单" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock x:Name="LabSummary" Margin="12,2,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                    </StackPanel>
                    <DataGrid x:Name="GridModules" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource ColorBrushGray6}"
                              BorderThickness="0" RowHeight="34" FontSize="12.5"
                              CanUserResizeRows="False" SelectionMode="Single"
                              SelectionChanged="GridModules_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="模块" Binding="{Binding Name}" Width="170" />
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="180" />
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="68" />
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="68" />
                            <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="{DynamicResource ColorBrushGray8}" CornerRadius="6"
                            Padding="12,10" Margin="0,12,0,0">
                        <TextBlock x:Name="LabDetail" TextWrapping="Wrap" MaxHeight="76"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧：主题色板 + 微软登录 -->
            <StackPanel Grid.Column="2">
                <Border Background="White" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="当前主题色板" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock x:Name="LabTheme" Margin="0,6,0,12" Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap" />
                        <UniformGrid Columns="8" Height="30">
                            <Rectangle Fill="{DynamicResource ColorBrush1}" />
                            <Rectangle Fill="{DynamicResource ColorBrush2}" />
                            <Rectangle Fill="{DynamicResource ColorBrush3}" />
                            <Rectangle Fill="{DynamicResource ColorBrush4}" />
                            <Rectangle Fill="{DynamicResource ColorBrush5}" />
                            <Rectangle Fill="{DynamicResource ColorBrush6}" />
                            <Rectangle Fill="{DynamicResource ColorBrush7}" />
                            <Rectangle Fill="{DynamicResource ColorBrush8}" />
                        </UniformGrid>
                        <UniformGrid Columns="8" Height="14" Margin="0,6,0,0">
                            <Rectangle Fill="{DynamicResource ColorBrushGray1}" />
                            <Rectangle Fill="{DynamicResource ColorBrushGray2}" />
                            <Rectangle Fill="{DynamicResource ColorBrushGray3}" />
                            <Rectangle Fill="{DynamicResource ColorBrushGray4}" />
                            <Rectangle Fill="{DynamicResource ColorBrushGray5}" />
                            <Rectangle Fill="{DynamicResource ColorBrushGray6}" />
                            <Rectangle Fill="{DynamicResource ColorBrushGray7}" />
                            <Rectangle Fill="{DynamicResource ColorBrushGray8}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="微软登录（设备码流程）" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock x:Name="LabMsState" Margin="0,6,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray3}" Text="尚未开始" />
                        <TextBlock x:Name="LabUserCode" FontSize="30" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource ColorBrush3}" Text="" />
                        <TextBlock x:Name="LabMsHint" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource ColorBrushGray2}" Text="" />
                        <Button x:Name="BtnLogin" Content="获取设备码并等待授权" Height="34"
                                Background="{DynamicResource ColorBrush3}" Foreground="White" BorderThickness="0"
                                Click="BtnLogin_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource ColorBrushGray7}" Padding="24,10">
            <TextBlock x:Name="LabFooter" Foreground="{DynamicResource ColorBrushGray2}"
                       Text="日志：logs\modules.log　·　模块目录：modules\" />
        </Border>
    </Grid>
</Window>
