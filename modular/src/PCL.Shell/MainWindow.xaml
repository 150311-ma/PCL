<Window x:Class="PCL.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PCL" Height="760" Width="1000" MinHeight="600" MinWidth="820"
        WindowStyle="None" ResizeMode="CanResize" Background="#F3F6FB"
        WindowStartupLocation="CenterScreen"
        FontFamily="PingFang SC, MiSans, Microsoft YaHei UI, 微软雅黑" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 玻璃面板：半透明白 + 白色高光边 + 柔和外阴影 = 液态玻璃的基本配方 -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#59FFFFFF" />
            <Setter Property="BorderBrush" Value="#B3FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.10" Color="#3A5A8C" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
            <Setter Property="Background" Value="#4DFFFFFF" />
            <Setter Property="BorderBrush" Value="#7AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#8CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="21">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35"
                                                  Color="{DynamicResource ColorObject3}" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#5B6472" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ══ 背景：柔光斑，玻璃卡片就是盖在它上面的 ══ -->
        <Grid ClipToBounds="True">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F7FAFF" Offset="0" />
                        <GradientStop Color="#E9F0FA" Offset="0.55" />
                        <GradientStop Color="#E3ECF7" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-190,-230,0,0" Fill="{DynamicResource ColorBrush4}" Opacity="0.42">
                <Ellipse.Effect>
                    <BlurEffect Radius="120" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-140,-170" Fill="{DynamicResource ColorBrush5}" Opacity="0.55">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-120,-80,0" Fill="#7FE0E8" Opacity="0.22">
                <Ellipse.Effect>
                    <BlurEffect Radius="100" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- 顶部 1px 高光：玻璃边缘的反光，别小看这一条，有没有差很多 -->
        <Border Height="1" VerticalAlignment="Top" Margin="26,0" Background="#E6FFFFFF" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- ══ 标题栏 ══ -->
            <Grid Grid.Row="0" Margin="18,0,10,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="9" Background="{DynamicResource ColorBrush3}">
                        <TextBlock Text="P" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PCL" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" />
                    <Border Background="#33000000" CornerRadius="8" Padding="7,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="LabVersion" Text="1.0.0" FontSize="11" Foreground="#5B6472" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMin" Style="{StaticResource ChromeButton}" Click="BtnMin_Click">
                        <Rectangle Width="11" Height="1.6" Fill="#5B6472" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource ChromeButton}" Click="BtnClose_Click" Margin="4,0,0,0">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#5B6472" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ══ 唯一的一页 ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,0">
                <StackPanel Margin="46,14,46,26" MaxWidth="980">

                    <TextBlock Text="把功能框架拖进来" FontSize="34" FontWeight="Bold"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock Margin="2,10,0,26" FontSize="13.5" Foreground="#66707F" TextWrapping="Wrap"
                               Text="PCL 只是一个空壳：首页之外的能力全部来自功能框架。支持 .pclpkg / .zip，拖进来就装好，装完立刻生效。" />

                    <!-- 拖放区 -->
                    <Grid x:Name="DropZoneArea" Height="212" AllowDrop="True">
                        <Rectangle x:Name="DropFrame" RadiusX="24" RadiusY="24" Fill="#33FFFFFF"
                                   Stroke="#8FA9C6" StrokeThickness="1.6" StrokeDashArray="5 4" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border x:Name="DropIcon" Width="62" Height="62" CornerRadius="20"
                                    Background="#66FFFFFF" BorderBrush="#99FFFFFF" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Path Data="M8,20 L8,10 A2,2 0 0 1 10,8 L26,8 A2,2 0 0 1 28,10 L28,20 A2,2 0 0 1 26,22 L10,22 A2,2 0 0 1 8,20 Z M10,26 L26,26"
                                      Stroke="{DynamicResource ColorBrush3}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="LabDropTitle" Text="拖入 .pclpkg 文件" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"
                                       Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock x:Name="LabDropHint" Text="也可以点下面的按钮从资源管理器里选"
                                       FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="#7C8798" />
                            <Button x:Name="BtnChoose" Content="选择功能框架包" Style="{StaticResource AccentButton}"
                                    Margin="0,18,0,0" Click="BtnChoose_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 已装框架 -->
                    <Grid Margin="2,32,0,10">
                        <TextBlock Text="已装框架" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock x:Name="LabCount" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12.5" Foreground="#7C8798" Text="0 个" />
                    </Grid>

                    <ItemsControl x:Name="ListModules">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCard}" CornerRadius="18" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="13" Background="{DynamicResource ColorBrush6}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource ColorBrush2}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ColorBrush1}" />
                                                <TextBlock Text="{Binding Version}" FontSize="11.5" Margin="8,2,0,0"
                                                           Foreground="#8A94A3" />
                                                <Border Background="#1A00C853" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding State}" FontSize="10.5" Foreground="#1B8A4B" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#7C8798"
                                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="卸载" Tag="{Binding Id}"
                                                Click="BtnUninstall_Click" Height="30"
                                                Padding="12,0" FontSize="12" VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanUninstall}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="LabEmpty" Text="还没有装任何功能框架。基础框架 pcl.core 是内置的，不需要装。"
                               FontSize="12.5" Foreground="#8A94A3" Margin="4,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- ══ 状态栏 ══ -->
            <Border Grid.Row="2" Background="#33FFFFFF" Padding="24,0">
                <Grid>
                    <TextBlock x:Name="LabStatus" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="#66707F" TextTrimming="CharacterEllipsis"
                               Text="就绪" />
                    <TextBlock x:Name="LabFooter" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="12" Foreground="#8A94A3" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
