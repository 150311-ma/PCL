<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PCL 本体（Plain Craft Launcher 2）
    从老式 .vbproj（ToolsVersion 15 / 逐个文件列举）翻新为 SDK 风格工程。

    翻新要点：
      1. 文件由 MSBuild 自动收集，不再维护 112 个 <Compile> / 60 个 <Page>；
      2. 配置改成 Debug / Release / Snapshot 三个，条件写法统一；
      3. 依赖分两类：仓库内 Resources\*.dll 用 HintPath，MeloongCore 用 ProjectReference；
      4. AssemblyName 保持 "Plain Craft Launcher 2" —— 代码里的
         pack://application:,,,/Plain Craft Launcher 2;component/Images/... 全靠它，改名会让所有内嵌图片失联；
      5. 关掉 SDK 自动生成的 AssemblyInfo，因为 My Project\AssemblyInfo.vb 里已经有一份。
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PCL</RootNamespace>
    <AssemblyName>Plain Craft Launcher 2</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Custom</MyType>
    <LangVersion>latest</LangVersion>

    <!-- 与老工程保持一致的 VB 语义：Option Strict Off 是 PCL 大量隐式转换的前提 -->
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>

    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Configurations>Debug;Release;Snapshot</Configurations>
    <!-- 老工程屏蔽的 VB 兼容性警告继续屏蔽，否则一次构建几百条噪音 -->
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>SNAPSHOT</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Snapshot'">
    <DefineConstants>SNAPSHOT</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- 启动对象：Application.xaml 的 StartupUri 指向 FormMain.xaml -->
  <ItemGroup>
    <ApplicationDefinition Include="Application.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

  <!--
    默认 glob 会把 Application.xaml 也当 Page，排掉，否则一个 XAML 编两遍。
    更要紧的是下面这两个 MySliderDot：仓库里放着，但老工程从来没有编译过它们
    （引用了 MathRange / SetTop / FrmMain.SliderDrag_Finish 等不存在的成员，是上游遗留的死文件）。
    SDK 自动收集会把它们捡进来，所以必须显式排除 —— 这是自动 glob 与手工清单的差别所在。
    确认方法：老 vbproj 的 <Compile> 112 条 vs 磁盘 113 个 .vb，差的就是这一个。
  -->
  <ItemGroup>
    <Page Remove="Application.xaml" />
    <Page Remove="Resources\Custom.xaml" />
    <Page Remove="Controls\MySliderDot.xaml" />
    <Compile Remove="Controls\MySliderDot.xaml.vb" />
    <None Include="Controls\MySliderDot.xaml" />
    <None Include="Controls\MySliderDot.xaml.vb" />
  </ItemGroup>

  <!-- 内嵌资源：pack://application:,,,/Plain Craft Launcher 2;component/Images/... 读的就是它们 -->
  <ItemGroup>
    <None Remove="Images\**\*" />
    <None Remove="Resources\Font.ttf" />
    <Resource Include="Images\**\*" />
    <Resource Include="Resources\Font.ttf" />
  </ItemGroup>

  <!-- 运行时要按路径读取、不参与编译的文件 -->
  <ItemGroup>
    <None Include="Resources\Help.zip" />
    <None Include="Resources\forge-installer.jar" />
    <None Include="Resources\transformer.jar" />
    <None Include="Resources\java-wrapper.jar" />
    <None Include="Resources\Custom.xaml" />
    <None Include="My Project\Settings.settings" />
    <None Include="My Project\app.manifest" />
  </ItemGroup>

  <!-- My.Resources 的强类型资源：基名必须是 PCL.Resources，Resources.Designer.vb 里就是这么找的 -->
  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <LogicalName>PCL.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 仓库内自带的第三方 dll，保持原位引用 -->
  <ItemGroup>
    <Reference Include="CacheCow.Client">
      <HintPath>Resources\CacheCow.Client.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CacheCow.Client.FileStore">
      <HintPath>Resources\CacheCow.Client.FileStore.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CacheCow.Common">
      <HintPath>Resources\CacheCow.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ThrottleDebounce">
      <HintPath>Resources\ThrottleDebounce.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Imazen.WebP">
      <HintPath>Resources\Imazen.WebP.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio">
      <HintPath>Resources\NAudio.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>Resources\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ookii.Dialogs.Wpf">
      <HintPath>Resources\Ookii.Dialogs.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Net.Http.Formatting">
      <HintPath>Resources\System.Net.Http.Formatting.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- .NET Framework 里不属于默认引用集的程序集 -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- .NET Framework 4.8 的参考程序集：让 dotnet CLI 也能编译 net48（不依赖 VS 的 Developer Pack） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" />
    <ProjectReference Include="..\MeloongCore\Wpf\MeloongCore.Wpf.csproj" />
    <ProjectReference Include="..\PCLCS\PCLCS.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    全局 Imports：老工程有 30 条，代码里 System.Windows / System.Threading / Newtonsoft.Json 之类
    从来没写过 Imports，全指望这里。少一条就是成片的“未定义类型”，所以必须原样搬过来。
  -->
  <ItemGroup>
    <Import Include="MeloongCore" />
    <Import Include="MeloongCore.Extensions" />
    <Import Include="MeloongCore.Wpf" />
    <Import Include="MeloongCore.Wpf.Extensions" />
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="Newtonsoft.Json" />
    <Import Include="Newtonsoft.Json.Linq" />
    <Import Include="PCLCS" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.IO.Compression" />
    <Import Include="System.Linq" />
    <Import Include="System.Net" />
    <Import Include="System.Net.Http" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Xml.Linq" />
    <Import Include="ThrottleDebounce" />
  </ItemGroup>

  <!-- 打整包时要带上的运行库（老工程靠 Link 把它们摆进 Resources\） -->
  <ItemGroup>
    <None Include="..\PCLCS\bin\PCLCS.dll">
      <Link>Resources\PCLCS.dll</Link>
    </None>
  </ItemGroup>

</Project>
